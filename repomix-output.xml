                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {(unassignedTests.length > 0 || unassignedVideos.length > 0) && (
                  <div>
                    <h2 className="text-base font-semibold text-gray-700 mb-3 flex items-center gap-2">
                      ⚠️ Heç yerə əlavə edilməyənlər
