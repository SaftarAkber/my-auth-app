generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?  @unique
  password  String
  role      Role     @default(STUDENT)
  bio       String?
  coverPhoto String? 
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Şifrə dəyişəndə artır: köhnə tokenlər (başqa cihazlardakı girişlər) etibarsız olur
  tokenVersion Int   @default(0)
  // Yumşaq silmə: hesab bağlanır, tələbələrə heç yerdə görünmür, müəllim və admin görür; admin bərpa edə bilər
  deletedAt     DateTime?
  // Silinəndə boşaldılan telefon/email (bərpa üçün), JSON: {"phone":..,"email":..}
  deletedContact String?
  videoPackages VideoPackage[]
  otpCodes         OtpCode[]
  groups           Group[]
  groupMembers     GroupMember[]
  enrollmentReqs   EnrollmentRequest[] @relation("StudentRequests")
  teacherReqs      EnrollmentRequest[] @relation("TeacherRequests")
  collections      Collection[]
  videos           Video[]
  attempts         StudentAttempt[]
  groupPosts       GroupPost[]
  videoComments    VideoComment[]
  videoViews       VideoView[]
  videoLikes       VideoLike[]
  postLikes        PostLike[]
  postComments     PostComment[]
  postCommentLikes PostCommentLike[]
  pushSubscriptions PushSubscription[]
  coinBalance Int    @default(0) 
  subjects   String[] @default([])   // müəllimin fənləri (ən çoxu 2)
  coinTransactions CoinTransaction[]       // ⬅️ YENİ
  orders           Order[] 
  topics           Topic[]

  @@map("users")
  reviewComments   ReviewComment[]
  assignments      Assignment[]
  assignmentExempts AssignmentExempt[]
  assignmentRewards AssignmentReward[]
}

model OtpCode {
  id        String   @id @default(cuid())
  code      String
  phone     String
  type      OtpType  @default(RESET_PASSWORD)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("otp_codes")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  schedule    String?
  photo       String?
  coverPhoto  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  members              GroupMember[]
  enrollmentReqs       EnrollmentRequest[]
  posts                GroupPost[]
  videoPackages        VideoPackage[]
  testPackages         TestPackage[]
  videoPackageGroups   VideoPackageGroup[]
  videoGroups          VideoGroup[]
  testPackageGroups    TestPackageGroup[]

  collectionGroups CollectionGroup[]
  topicGroups      TopicGroup[]

  @@map("groups")
  assignmentGroups AssignmentGroup[]
}

model VideoPackageGroup {
  id        String       @id @default(cuid())
  packageId String
  groupId   String
  package   VideoPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([packageId, groupId])
  @@map("video_package_groups")
}

model CollectionGroup {
  id           String     @id @default(cuid())
  collectionId String
  groupId      String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([collectionId, groupId])
  @@map("collection_groups")
}

model TestPackageGroup {
  id        String      @id @default(cuid())
  packageId String
  groupId   String
  package   TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([packageId, groupId])
  @@map("test_package_groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  groupId   String
  studentId String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@map("group_members")
}

model EnrollmentRequest {
  id            String                @id @default(cuid())
  message       String?
  teacherReply  String?
  status        EnrollmentStatus      @default(PENDING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  studentId     String
  teacherId     String
  groupId       String
  student       User                  @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  teacher       User                  @relation("TeacherRequests", fields: [teacherId], references: [id], onDelete: Cascade)
  group         Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
  @@map("enrollment_requests")
}

model GroupPost {
  id        String      @id @default(cuid())
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  groupId   String
  teacherId String
  visibility PostVisibility @default(GROUP)
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  images    GroupPostImage[]
  likes     PostLike[]
  comments  PostComment[]

  @@map("group_posts")
}

// Paylaşım bəyənməsi. Bir neçə qrupa göndərilmiş paylaşımın sətirləri bir kart sayılır:
// bəyənmələr bütün qardaş sətirlər üzrə yığılır (lib/posts.ts)
model PostLike {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  postId    String
  userId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

// Paylaşım şərhi (videodakı kimi bir səviyyə cavab). Qardaş sətirlərin şərhləri bir kartda yığılır
model PostComment {
  id        String            @id @default(cuid())
  content   String
  createdAt DateTime          @default(now())
  postId    String
  userId    String
  parentId  String?
  post      GroupPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    PostComment?      @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[]     @relation("PostCommentReplies")
  likes     PostCommentLike[]

  @@index([postId, parentId, createdAt])
  @@index([parentId])
  @@map("post_comments")
}

model PostCommentLike {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  commentId String
  userId    String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("post_comment_likes")
}

model GroupPostImage {
  id        String    @id @default(cuid())
  url       String
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@map("group_post_images")
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  teacherId   String
  teacher     User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  packages    TestPackage[]
  videoPackages VideoPackage[]
  // GROUP_ONLY: kolleksiya yalnız seçilmiş qruplarda görünür (PUBLIC: məhdudiyyət yoxdur)
  visibility  ContentVisibility @default(PUBLIC)
  groups      CollectionGroup[]
  // Yumşaq silmə: müəllim siləndə bazadan çıxmır, admin bərpa edə bilir
  deletedAt   DateTime?
  deletedById String?

  @@map("collections")
}

model VideoPackage {
  id           String      @id @default(cuid())
  name         String
  description  String?
  isPublished  Boolean     @default(false)
  isPublic     Boolean     @default(false)
  visibility   ContentVisibility @default(PUBLIC)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  collectionId String?
  groupId      String?
  teacherId    String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  group        Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teacher      User?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  videos       Video[]
  videoPackageGroups VideoPackageGroup[]

  @@map("video_packages")
}

model Video {
  id           String       @id @default(cuid())
  title        String
  description  String?
  url          String
  publicId     String?
  // Yüklənmiş videolar üçün (publicId dolu): ölçü (bayt) və müddət (saniyə) — yer limiti və göstərmək üçün
  bytes        Int?
  duration     Int?
  isActive     Boolean      @default(true)
  visibility   ContentVisibility @default(PUBLIC)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  teacherId    String
  packageId    String?
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  package      VideoPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  comments     VideoComment[]
  videoGroups  VideoGroup[]
  // Hər video öz vəziyyətindədir: qaralama (isPublished=false), hamıya açıq (PUBLIC) və ya seçilmiş qruplar (GROUP_ONLY + videoGroups)
  isPublished  Boolean      @default(false)
  // Son dərc vaxtı (tələbə bildirişləri üçün; lib/prisma.ts avtomatik yazır)
  publishedAt  DateTime?
  // Admin sancağı (1-3): sancılmış video bütün istifadəçilərə sağ siyahının yuxarısında göstərilir
  pinOrder     Int?
  views        VideoView[]
  likes        VideoLike[]
  topicVideos  TopicVideo[]

  @@map("videos")
  reviewComments ReviewComment[]
}

model VideoGroup {
  id      String @id @default(cuid())
  videoId String
  groupId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([videoId, groupId])
  @@map("video_groups")
}

model VideoComment {
  id         String           @id @default(cuid())
  content    String
  createdAt  DateTime         @default(now())
  visibility CommentVisibility @default(PUBLIC)
  videoId    String
  userId     String
  video      Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cavab: yalnız bir səviyyə (YouTube kimi); əsas şərh silinəndə cavabları da silinir
  parentId   String?
  parent     VideoComment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    VideoComment[]   @relation("CommentReplies")

  @@index([videoId, parentId, createdAt])
  @@map("video_comments")
}

// Hər istifadəçidən hər video üçün bir baxış sayılır (F5 ilə şişirdilməsin)
model VideoView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  videoId   String
  userId    String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([createdAt])
  @@map("video_views")
}

model VideoLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  videoId   String
  userId    String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@map("video_likes")
}

model TestPackage {
  id           String    @id @default(cuid())
  name         String
  description  String?
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  isPublic     Boolean   @default(false)
  isTimed      Boolean   @default(false)
  duration     Int?
  startsAt     DateTime?
  // Aylıq sınaq xatırlatmaları göndərilib (3 saat və 1 saat 20 dəqiqə qalmış)
  remind3hAt  DateTime?
  remind80At  DateTime?
  endsAt       DateTime?
  visibility   ContentVisibility @default(PUBLIC)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  collectionId String?
  groupId      String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  group        Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  questions    Question[]
  attempts     StudentAttempt[]
  allowRetry   Boolean @default(false)
  shareAnswers Boolean @default(false)
  deletedAt    DateTime?
  deletedById  String?
  testPackageGroups TestPackageGroup[]
  topicTests   TopicTest[]
  // Müəllimin istəyə bağlı coin mükafatı qaydası
  rewardEnabled    Boolean @default(false)
  rewardMinCorrect Int?
  rewardCoins      Int?
  rewardAuto       Boolean @default(true)
  // Sual bankı: hər cəhddə səviyyələr üzrə təsadüfi suallar seçilir
  isBank      Boolean @default(false)
  drawEasy    Int     @default(4)
  drawMedium  Int     @default(6)
  drawHard    Int     @default(15)
  // Aylıq sınaq: qrupun yarış cədvəlinə düşür (ilk cəhd sayılır)
  isMonthly   Boolean @default(false)

  @@map("test_packages")
  assignments Assignment[]
}

model Question {
  id            String       @id @default(cuid())
  text          String
  type          QuestionType @default(MULTIPLE_CHOICE)
  options       Json?
  correctAnswer String?
  imageUrl      String?
  difficulty    Difficulty?
  isActive      Boolean      @default(true)
  // "Sualları sıfırla": cəhdlərdə istifadə olunmuş sual silinmir, arxivə keçir – redaktorda və yeni testlərdə
  // görünmür, tələbələrin tarixçəsində (cavab kitabçası, reytinq) qalır
  archivedAt    DateTime?
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  packageId     String
  package       TestPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  answers       StudentAnswer[]

  @@map("questions")
  reviewComments ReviewComment[]
}

model StudentAttempt {
  id          String        @id @default(cuid())
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  score       Int?
  totalScore  Int?
  createdAt   DateTime      @default(now())
  studentId   String
  packageId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  package     TestPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  answers     StudentAnswer[]
  rewardGranted Boolean @default(false)
  rewardCoins   Int     @default(0)
  // Bank testində bu cəhd üçün seçilmiş suallar (sıra ilə); adi testdə boşdur
  questionIds   String[] @default([])
  // Davam edən testin yadda saxlanmış cavabları { questionId: answer }
  draft         Json?

  @@index([packageId, studentId])
  @@map("student_attempts")
  reviewComments ReviewComment[]
}

model StudentAnswer {
  id             String        @id @default(cuid())
  answer         String
  isCorrect      Boolean?
  teacherComment String?
  status         AnswerStatus  @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  attemptId      String
  questionId     String
  attempt        StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("student_answers")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum OtpType {
  RESET_PASSWORD
  PHONE_VERIFY
  EMAIL_VERIFY
}

enum EnrollmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN_ENDED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AnswerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentVisibility {
  PUBLIC
  GROUP_ONLY
}

enum PostVisibility {
  PUBLIC
  GROUP
}

enum CommentVisibility {
  PUBLIC
  GROUP_ONLY
}

model CoinTransaction {
  id        String              @id @default(cuid())
  userId    String
  amount    Int                 // müsbət = qazanc, mənfi = xərc
  type      CoinTransactionType
  reason    String?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Hədiyyədə qarşı tərəf (göndərəndə alıcı, alanda göndərən). Ad da saxlanır ki, hesab silinsə də tarixçədə qalsın
  counterpartyId   String?
  counterpartyName String?

  @@map("coin_transactions")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  imageUrl    String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("products")
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  productId String
  quantity  Int         @default(1)
  totalCost Int
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("orders")
}

enum CoinTransactionType {
  INITIAL_GRANT
  TEST_CREATED
  CORRECT_ANSWER
  RANK_REWARD
  PURCHASE
  ADMIN_ADJUST
  GIFT_SENT
  GIFT_RECEIVED
  TEST_REWARD
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// Mövzu paketi: müəllimin bir mövzu üzrə qeydləri (kitabxana) + bağlı test paketləri və videolar.
// Bir mövzu bir neçə qrupla paylaşıla bilər; qaralama (isPublished=false) yalnız müəllimə görünür.
model Topic {
  id          String   @id @default(cuid())
  title       String
  // Kitabxana: təmizlənmiş HTML (server tərəfdə icazəli teq və stillərlə süzülür)
  content     String   @default("")
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  // PUBLIC – hərkəsə açıq; GROUP_ONLY – yalnız seçilmiş qruplara (TopicGroup)
  visibility  ContentVisibility @default(GROUP_ONLY)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  groups      TopicGroup[]
  tests       TopicTest[]
  videos      TopicVideo[]

  @@index([teacherId, order])
  @@map("topics")
}

model TopicGroup {
  id      String @id @default(cuid())
  topicId String
  groupId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([topicId, groupId])
  @@index([groupId])
  @@map("topic_groups")
}

model TopicTest {
  id        String      @id @default(cuid())
  topicId   String
  packageId String
  order     Int         @default(0)
  topic     Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  package   TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([topicId, packageId])
  @@map("topic_tests")
}

model TopicVideo {
  id      String @id @default(cuid())
  topicId String
  videoId String
  order   Int    @default(0)
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([topicId, videoId])
  @@map("topic_videos")
}

// Giriş və kod cəhdlərinin sayğacı (Vercel bir neçə server açır — yaddaşdakı sayğac kifayət etmir)
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}

// Telefon (PWA) bildirişləri üçün brauzerin abunəliyi; bir istifadəçinin bir neçə cihazı ola bilər
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Müəllimin tələbə cavab kitabçasındakı şərhi (sual üzrə): mətn (linklər kliklənir), ≤10 şəkil, sayt videosu və ya YouTube.
// ATTEMPT – yalnız bu cəhdə; WRONG_ALL – bu sualı səhv edən (və ya cavabsız qoyan) hər tələbə görür, düz cavab verən görmür.
// sentAt boşdursa qaralamadır: tələbə görmür; müəllim "Qeydləri göndər" deyəndə göndərilir və tələbəyə bildiriş gedir.
model ReviewComment {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  teacherId  String
  scope      ReviewScope @default(ATTEMPT)
  text       String      @default("")
  images     String[]    @default([])
  videoId    String?
  youtubeUrl String?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  attempt    StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  teacher    User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  video      Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([questionId, scope])
  @@map("review_comments")
}

enum ReviewScope {
  ATTEMPT
  WRONG_ALL
}

// Ev tapşırığı (hələlik yalnız test): seçilmiş qrupların tələbələri (azad edilənlərdən başqa) son tarixə qədər
// paketi ən azı minAttempts dəfə bitirməlidir. Yalnız tapşırıq verildikdən SONRA başlanan və son tarixə qədər
// bitən cəhdlər sayılır (sualların yarısı cavablanmalı); son tarixdə say dondurulur.
model Assignment {
  id          String   @id @default(cuid())
  teacherId   String
  packageId   String
  minAttempts Int      @default(1)
  deadline    DateTime
  // Vaxtında bitirənə müəllimin balansından avtomatik coin (boşdursa verilmir)
  coinReward  Int?
  note        String?
  // Xatırlatmalar göndərilib (son tarixə 1 gün və 3 saat qalmış)
  remind1dAt  DateTime?
  remind3hAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  package     TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  groups      AssignmentGroup[]
  exempts     AssignmentExempt[]
  rewards     AssignmentReward[]

  @@index([teacherId])
  @@index([packageId])
  @@map("assignments")
}

model AssignmentGroup {
  assignmentId String
  groupId      String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([assignmentId, groupId])
  @@index([groupId])
  @@map("assignment_groups")
}

model AssignmentExempt {
  assignmentId String
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
  @@map("assignment_exempts")
}

// Tapşırıq üçün coin bir dəfə verilir
model AssignmentReward {
  assignmentId String
  studentId    String
  coins        Int
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
  @@map("assignment_rewards")
}
